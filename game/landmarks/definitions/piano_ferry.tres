[gd_resource type="Resource" load_steps=8 format=3]

[ext_resource type="Script" path="res://game/landmarks/landmark_definition.gd" id="1_definition"]
[ext_resource type="Script" path="res://game/landmarks/landmark_progress_profile.gd" id="2_profile"]
[ext_resource type="AudioStream" path="res://resources/audio/sfx/landmark_cues/piano_ferry_refrain.ogg" id="3_audio"]

[sub_resource type="Resource" id="Progress_default"]
script = ExtResource("2_profile")
profile_id = &"default"
progress = {"harbor_clue_found": false, "state": "locked"}

[sub_resource type="Resource" id="Progress_new_game"]
script = ExtResource("2_profile")
profile_id = &"new_game"
progress = {"harbor_clue_found": false, "state": "available"}

[sub_resource type="Resource" id="Progress_continue"]
script = ExtResource("2_profile")
profile_id = &"continue"
progress = {"harbor_clue_found": true, "state": "reward_collected"}

[sub_resource type="Resource" id="Progress_free_walk"]
script = ExtResource("2_profile")
profile_id = &"free_walk"
progress = {"harbor_clue_found": false, "state": "introduced"}

[resource]
script = ExtResource("1_definition")
id = &"piano_ferry"
display_name = "Piano Ferry"
world_node_path = NodePath("Landmarks/PianoFerryProxy")
isometric_position = Vector2(5248, 9376)
is_default_resume_anchor = true
audio_cue_id = &"piano_ferry"
audio_cue = ExtResource("3_audio")
progress_profiles = Array[ExtResource("2_profile")]([SubResource("Progress_default"), SubResource("Progress_new_game"), SubResource("Progress_continue"), SubResource("Progress_free_walk")])
